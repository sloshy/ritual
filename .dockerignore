# The build context is what `COPY . .` puts into the builder stage. Keep it to
# what `scripts/build.sh` needs: package.json, bun.lock, vendor/, index.ts,
# src/, scripts/, locales/, LICENSE and app.svg (both embedded in the binary).
#
# Everything below is either rebuilt inside the image or must never reach it:
# a developer's workspace data and credentials (.logins/ holds the admin
# password hash and Archidekt tokens), and host-built artifacts.

# VCS, tooling and editor state
.git
.github
.husky
.claude
.playwright
.playwright-cli
.vscode
.idea
.eslintcache
*.tsbuildinfo
.DS_Store

# Dependencies: installed inside the image for its own platform (musl)
node_modules
docs-site

# Workspace data and credentials
.logins
.env
.env.*
ritual.config.json
set-env.sh
install_dev.sh
decks
collections
wanted
exports
cache

# Build outputs, regenerated by scripts/build.sh
ritual
ritual.map
*.js.map
dist
.admin-dist
.dist-build-*
.dist-old-*
src/generated
**/*.compiled.css
**/*.compiled.js
locales/en-XA.json

# Not needed to build
test
test-results
playwright-report
research
TODO.md
