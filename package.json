{
  "name": "ritual",
  "version": "0.1.0",
  "description": "Your Magic: The Gathering decks and collection as plain files: price them, sync them, and publish them as your own website.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/sloshy/ritual",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sloshy/ritual.git"
  },
  "bugs": {
    "url": "https://github.com/sloshy/ritual/issues"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "sh scripts/build.sh",
    "build:assets": "sh scripts/build-assets.sh",
    "dev": "bun scripts/dev.ts",
    "serve": "bun run index.ts serve --build",
    "format": "bun fmt",
    "check-format": "bun fmt --check",
    "lint": "eslint . --concurrency auto",
    "lint:repo": "bash scripts/lint-repo.sh",
    "precommit": "bun run scripts/precommit.ts",
    "verify": "bun run scripts/precommit.ts --full",
    "test": "bun run scripts/precommit.ts --test",
    "test:it": "RITUAL_BUNDLED_LOCALES=en-XA bun run build && bun check --no-script && RITUAL_IT_PREBUILT=1 bun test test/integration",
    "test:e2e": "RITUAL_BUNDLED_LOCALES=en bun run build:assets && bunx playwright test",
    "prepare": "husky"
  },
  "bin": {
    "ritual": "./index.ts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-typescript": "^8.0.7",
    "@dschz/bun-plugin-solid": "^1.0.4",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/rule-tester": "^8.72.0",
    "babel-preset-solid": "^1.9.16",
    "commander": "^15.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "prompts": "^2.4.2",
    "solid-js": "^1.9.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "peerDependencies": {},
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "create-torrent": "^6.1.3",
    "parse-torrent": "^11.0.24",
    "webrtc-polyfill": "./vendor/webrtc-polyfill",
    "webtorrent": "^3.0.21",
    "zod": "^4.6.7"
  },
  "overrides": {
    "webrtc-polyfill": "file:./vendor/webrtc-polyfill"
  }
}
