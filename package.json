{
  "name": "ritual",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "homepage": "https://github.com/sloshy/ritual",
  "bugs": {
    "url": "https://github.com/sloshy/ritual/issues"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "sh scripts/build.sh",
    "version:sync": "bun run scripts/sync-version.ts",
    "serve": "bun run index.ts build-site && bun run index.ts serve",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "bun run build && bunx tsc --noEmit && bun test test/unit",
    "test:it": "rm -rf cache && mkdir -p cache && bun run build && bunx tsc --noEmit && bun test test/integration",
    "test:e2e": "sh scripts/bundle-assets.sh && bunx playwright test",
    "prepare": "husky"
  },
  "bin": {
    "ritual": "./index.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@dschz/bun-plugin-solid": "^1.0.4",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.12",
    "@types/js-yaml": "^4.0.9",
    "@types/prompts": "^2.4.9",
    "babel-preset-solid": "^1.9.12",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prompts": "^2.4.2",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {},
  "dependencies": {}
}
