{
  "name": "ritual",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "homepage": "https://github.com/sloshy/ritual",
  "bugs": {
    "url": "https://github.com/sloshy/ritual/issues"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "sh scripts/build.sh",
    "build:assets": "bun run scripts/generate-licenses.ts && bun run scripts/generate-locales.ts && sh scripts/bundle-assets.sh",
    "dev": "bun scripts/dev.ts",
    "version:sync": "bun run scripts/sync-version.ts",
    "serve": "bun run index.ts serve --build",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "lint": "eslint . --concurrency auto",
    "precommit": "bun run scripts/precommit.ts",
    "verify": "bun run scripts/precommit.ts --full",
    "test": "bun run scripts/precommit.ts --test",
    "test:it": "RITUAL_BUNDLED_LOCALES=en-XA bun run build && bunx tsc --noEmit && RITUAL_IT_PREBUILT=1 bun test test/integration",
    "test:e2e": "RITUAL_BUNDLED_LOCALES=en bun run build:assets && bunx playwright test",
    "prepare": "husky"
  },
  "bin": {
    "ritual": "./index.ts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@dschz/bun-plugin-solid": "^1.0.4",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.61.0",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/rule-tester": "^8.61.1",
    "babel-preset-solid": "^1.9.12",
    "commander": "^15.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "prompts": "^2.4.2",
    "solid-js": "^1.9.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "peerDependencies": {},
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "create-torrent": "^6.1.2",
    "parse-torrent": "^11.0.21",
    "webrtc-polyfill": "./vendor/webrtc-polyfill",
    "webtorrent": "^3.0.16",
    "zod": "^4.4.3"
  },
  "overrides": {
    "webrtc-polyfill": "file:./vendor/webrtc-polyfill"
  }
}
